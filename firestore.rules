rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if ownsUserDocument(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email;
      allow read: if ownsUserDocument(userId);
      allow update: if ownsUserDocument(userId)
        && request.resource.data.id == userId;
      allow delete: if false;

      // Profile photo stored in Firestore as JPEG/PNG bytes (max 500 KB).
      match /avatar/{docId} {
        allow read, delete: if ownsUserDocument(userId);
        allow create, update: if ownsUserDocument(userId)
          && docId == 'current'
          && request.resource.data.keys().hasOnly(['image', 'contentType', 'updatedAt'])
          && request.resource.data.image is bytes
          && request.resource.data.image.size() > 0
          && request.resource.data.image.size() <= 500 * 1024
          && request.resource.data.contentType in ['image/jpeg', 'image/png'];
      }

      match /favourites/{mealId} {
        allow read, delete: if ownsUserDocument(userId);
        allow create, update: if ownsUserDocument(userId)
          && request.resource.data.id == mealId;
      }

      match /orders/{orderId} {
        allow read: if ownsUserDocument(userId);
        allow create: if ownsUserDocument(userId)
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.total is number
          && request.resource.data.total > 0;
        allow update, delete: if false;
      }
    }
  }
}
